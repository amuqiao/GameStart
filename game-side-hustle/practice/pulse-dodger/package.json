{
  "name": "pulse-dodger",
  "version": "1.0.0",
  "description": "Pulse Dodger - a Phaser 3 + TypeScript + Vite game wired for the CrazyGames HTML5 SDK v3.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "npm run check:boundaries && npm run test && tsc --noEmit && vite build --config vite/config.prod.mjs",
    "preview": "vite preview --config vite/config.prod.mjs --port 8081",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/build-zip.mjs",
    "portal:upload": "npm run package && node scripts/prepare-portal-upload.mjs",
    "materials": "node scripts/generate-submission-materials.mjs",
    "check:size": "node scripts/build-zip.mjs --check-only",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  }
}
